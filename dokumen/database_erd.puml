@startuml
!pragma layout smetana
hide methods
hide stereotypes
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam entity {
  BackgroundColor #F8FAFC
  BorderColor #2563EB
}

entity roles {
  * role_id : UUID <<PK>>
  --
  * role_code : VARCHAR <<UNIQUE>>
  * role_name : VARCHAR
}
entity users {
  * user_id : UUID <<PK>>
  --
  * role_id : UUID <<FK>>
  opd_id : UUID <<FK>> (null)
  * email : VARCHAR <<UNIQUE>>
  * is_active : BOOLEAN
}
entity opd {
  * opd_id : UUID <<PK>>
  --
  * opd_code : VARCHAR <<UNIQUE>>
  * name : VARCHAR
  * level : VARCHAR
  wilayah_id : UUID <<FK>> (null)
}
entity wilayah {
  * wilayah_id : UUID <<PK>>
  --
  parent_id : UUID <<FK>> (null)
  * name : VARCHAR
  * type : VARCHAR
}
entity providers {
  * provider_id : UUID <<PK>>
  --
  * name : VARCHAR
  classification_label : VARCHAR (null)
}
entity provider_aliases {
  * alias_id : UUID <<PK>>
  --
  * provider_id : UUID <<FK>>
  * alias_name : VARCHAR <<UNIQUE>>
}
entity categories {
  * category_id : UUID <<PK>>
  --
  * category_code : VARCHAR <<UNIQUE>>
  * name : VARCHAR
}
entity import_batches {
  * batch_id : UUID <<PK>>
  --
  * source_filename : VARCHAR
  * source_checksum : CHAR(64)
  * imported_by : UUID <<FK>>
  * imported_at : TIMESTAMP
  * status : VARCHAR
  source_total : DECIMAL (null)
  imported_total : DECIMAL (null)
}
entity activities {
  * activity_id : UUID <<PK>>
  --
  * opd_id : UUID <<FK>>
  provider_id : UUID <<FK>> (null)
  wilayah_id : UUID <<FK>> (null)
  category_id : UUID <<FK>> (null)
  import_batch_id : UUID <<FK>> (null)
  * report_year : SMALLINT
  * period_start_year : SMALLINT
  * period_end_year : SMALLINT
  * description : TEXT
  recipient_location : VARCHAR (null)
  * aid_form : VARCHAR
  quantity : DECIMAL (null)
  unit : VARCHAR (null)
  source_amount : DECIMAL(18,2) (null)
  * value_status : VARCHAR
  coordination_form : TEXT (null)
  target_outcome : TEXT (null)
  source_sheet : VARCHAR (null)
  source_row : INTEGER (null)
  * workflow_status : VARCHAR
  * created_by : UUID <<FK>>
}
entity documents {
  * document_id : UUID <<PK>>
  --
  * activity_id : UUID <<FK>>
  * document_type : VARCHAR
  document_number : VARCHAR (null)
  * storage_key : VARCHAR
  * visibility : VARCHAR
  * uploaded_by : UUID <<FK>>
}
entity administrative_references {
  * admin_ref_id : UUID <<PK>>
  --
  * activity_id : UUID <<FK>>
  * reference_type : VARCHAR
  reference_number : VARCHAR (null)
  * updated_by : UUID <<FK>>
}
entity planning_references {
  * reference_id : UUID <<PK>>
  --
  * reference_type : VARCHAR
  * fiscal_year : SMALLINT
  opd_id : UUID <<FK>> (null)
  * reference_code : VARCHAR
}
entity potential_matches {
  * match_id : UUID <<PK>>
  --
  * activity_id : UUID <<FK>>
  * reference_id : UUID <<FK>>
  match_score : DECIMAL (null)
  * review_status : VARCHAR
}
entity scenarios {
  * scenario_id : UUID <<PK>>
  --
  * created_by : UUID <<FK>>
  * filters_json : JSON
}
entity scenario_items {
  * scenario_id : UUID <<PK, FK>>
  * activity_id : UUID <<PK, FK>>
  --
  * include_in_total : BOOLEAN
}
entity publications {
  * publication_id : UUID <<PK>>
  --
  * prepared_by : UUID <<FK>>
  approved_by : UUID <<FK>> (null)
  * status : VARCHAR
}
entity publication_items {
  * publication_id : UUID <<PK, FK>>
  * activity_id : UUID <<PK, FK>>
  --
  * public_snapshot : JSON
}
entity activity_log {
  * log_id : UUID <<PK>>
  --
  * user_id : UUID <<FK>>
  * entity_type : VARCHAR
  * entity_id : UUID
  * action : VARCHAR
  * changed_at : TIMESTAMP
}

roles ||--o{ users
opd |o--o{ users
opd ||--o{ activities
wilayah |o--o{ opd
wilayah |o--o{ activities
wilayah |o--o{ wilayah : parent
providers |o--o{ activities
providers ||--o{ provider_aliases
categories |o--o{ activities
import_batches |o--o{ activities
users ||--o{ import_batches
activities ||--o{ documents
activities ||--o{ administrative_references
activities ||--o{ potential_matches
planning_references ||--o{ potential_matches
users ||--o{ scenarios
scenarios ||--o{ scenario_items
activities ||--o{ scenario_items
users ||--o{ publications : prepares
users |o--o{ publications : approves
publications ||--o{ publication_items
activities ||--o{ publication_items
users ||--o{ activity_log

note bottom of activities
source_amount NULL = nilai tidak dicantumkan;
nol disimpan terpisah. source_sheet dan source_row
menjaga jejak ke baris Excel asal.
end note
@enduml
